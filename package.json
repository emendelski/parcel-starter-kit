{
  "name": "parcel-starter-kit",
  "version": "2.0.0",
  "description": "Simple boilerplate: Parcel, Bulma, PostHTML, SCSS, ESLint, Stylelint and Prettier",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emendelski/parcel-starter-kit.git"
  },
  "source": "index.html",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "parcel",
    "serve": "npm run dev",
    "build": "parcel build",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"scss/**/*.scss\""
  },
  "dependencies": {
    "bulma": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/transformer-sass": "^2.16.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "parcel": "^2.16.4",
    "posthtml-include": "^2.0.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0"
  }
}
